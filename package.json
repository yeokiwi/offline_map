{
  "name": "offline-map",
  "version": "1.0.0",
  "description": "Offline map viewer for Singapore with street and satellite views",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "download:street": "node downloader.js --type street --zoom 15 --bbox 103.6,1.15,104.1,1.50",
    "download:satellite": "node downloader.js --type satellite --zoom 15 --bbox 103.6,1.15,104.1,1.50"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@turf/turf": "^7.2.0",
    "axios": "^1.6.7",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "geojson-path-finder": "^2.0.2",
    "leaflet": "^1.9.4",
    "openai": "^6.27.0",
    "sql.js": "^1.10.3"
  }
}
